# Copy to .env.local if you want to override defaults. Everything is optional.

# Use a real PostgreSQL server instead of the embedded PGlite database.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskforge

# Directory for the embedded PGlite database (used when DATABASE_URL is unset).
# PGLITE_DIR=.data/pglite

# HMAC secret for the demo session cookie. A fixed development default is used when unset.
# SESSION_SECRET=change-me
